# ─────────────────────────────────────────────────────────────
# 准入口令配置（示例文件，勿提交真实值）
#
# 复制为 .env.local 后填写；.env / .env.local 已在 .gitignore 中。
#
# ⚠️ 纯前端 SPA 的口令最终会进入构建产物，任何人都能从浏览器读到，
#    客户端口令门只是「软门槛」。真正需要强准入控制时必须加服务端。
#
# 优先级：用户本机自定义（localStorage） > 这里的构建期配置。
# 全部留空时，应用进入「首次使用」流程，引导用户在本机设置自己的口令。
# ─────────────────────────────────────────────────────────────

# 情侣模式进入口令（至少 4 位数字）
VITE_APP_COUPLE_PWD=

# 普通模式进入口令（至少 4 位数字）
VITE_APP_NORMAL_PWD=

# 小说书房暗号（至少 4 位数字），在门禁面板直接输入可直达书房
VITE_APP_NOVEL_CODE=
